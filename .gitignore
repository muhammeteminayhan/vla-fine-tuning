# Checkpoints and model weights - too large for git
checkpoints/
outputs/
*.safetensors
*.ckpt
*.pt

# Dataset cache. Anchored to the repo root so it does not swallow src/data/.
/data/
/.cache/

# Large videos. Small Phase 0 / Phase 5 demo clips are force-added.
assets/**/*.mp4
assets/**/*.mkv

# Eval rollout videos: kept on disk for Phase 4 error analysis, not in git.
# results/**/results.json IS tracked - it is the reproducibility evidence.
results/**/*.mp4
results/**/failures/

# Driver stdout: mostly tqdm carriage returns. The milestone timelines
# (results/*_milestones.log) are tracked instead.
results/*_raw.log

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Tooling
.ipynb_checkpoints/
wandb/
.DS_Store

# Derived from the gitignored rollout videos.
results/**/failure_strips/

results/reeval_n10_progress.log
